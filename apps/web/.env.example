# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Landing page product demo video (YouTube URL). Defaults to a placeholder if unset.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Next.js -> Azure Functions proxy (server-side only, never NEXT_PUBLIC_)
AZURE_FUNCTIONS_API_URL=
AZURE_FUNCTIONS_KEY=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
# "false" lets Stripe Checkout skip card collection while $0 is due (trial-without-card).
STRIPE_TRIAL_REQUIRES_CARD=true

# Super-admin dashboard: comma-separated Clerk user IDs, and/or comma-separated emails
ADMIN_USER_IDS=
ADMIN_EMAILS=
# Local-only escape hatch for /admin while you're still setting up Clerk/allowlists.
# Only takes effect when NODE_ENV isn't "production" — never set this on a real deployment.
ALLOW_DEV_ADMIN=
