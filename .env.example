# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Clerk — org/team accounts for agency multi-user access)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Azure OpenAI (single structured-output GPT-4o call for SOW extraction)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure Speech (transcription + async post-call translation)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure Storage (blob uploads + queue trigger for Durable Functions audio pipeline)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_UPLOADS=uploads
AZURE_STORAGE_QUEUE_AUDIO_PROCESSING=audio-processing

# Azure Cosmos DB
COSMOS_DB_CONNECTION_STRING=
COSMOS_DB_DATABASE_NAME=sowflow

# Azure AI Search (per-agency clause/pricing memory fed into extraction prompt)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=sow-memory

# Stripe (subscription tiers + metered overage on transcription minutes)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
# "false" lets Stripe Checkout skip card collection while $0 is due (trial-without-card).
STRIPE_TRIAL_REQUIRES_CARD=true

# Super-admin dashboard: comma-separated Clerk user IDs
ADMIN_USER_IDS=

# gpt-4o $/1K-token pricing used to estimate cost on the admin dashboard
GPT4O_INPUT_COST_PER_1K=0.0025
GPT4O_OUTPUT_COST_PER_1K=0.01

# E-signature / client approval links
SOW_APPROVAL_LINK_SECRET=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Next.js -> Azure Functions proxy (server-side only, never NEXT_PUBLIC_)
AZURE_FUNCTIONS_API_URL=
AZURE_FUNCTIONS_KEY=